{
  "name": "@openpen/module-api",
  "version": "0.0.0",
  "description": "OpenPen Module API — public contract for built-in modules and third-party plugins",
  "author": "navishachiku <navishachiku@gmail.com>",
  "homepage": "https://github.com/openpen-platform/openpen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpen-platform/openpen.git",
    "directory": "packages/module-api"
  },
  "bugs": {
    "url": "https://github.com/openpen-platform/openpen/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./uikit": {
      "types": "./src/uikit/index.ts",
      "import": "./src/uikit/index.ts"
    },
    "./uikit/tokens.css": "./src/uikit/tokens.css",
    "./uikit/internal": {
      "types": "./src/uikit/internal.ts",
      "import": "./src/uikit/internal.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts"
    }
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "keywords": [
    "openpen",
    "plugin",
    "module",
    "sdk"
  ],
  "dependencies": {
    "reka-ui": "~2.9.7"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  }
}
