{
  "name": "@openpen/module-api",
  "version": "1.3.0",
  "description": "OpenPen Module API — public contract for built-in modules and third-party plugins",
  "author": "navishachiku <navishachiku@gmail.com>",
  "homepage": "https://github.com/openpen-platform/openpen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpen-platform/openpen.git",
    "directory": "packages/module-api"
  },
  "bugs": {
    "url": "https://github.com/openpen-platform/openpen/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./uikit": {
      "types": "./dist/uikit/index.d.ts",
      "import": "./dist/uikit/index.js"
    },
    "./uikit/tokens.css": "./dist/uikit/tokens.css",
    "./uikit/internal": {
      "types": "./dist/uikit/internal.d.ts",
      "import": "./dist/uikit/internal.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./host/registry": {
      "types": "./dist/host/registry.d.ts",
      "import": "./dist/host/registry.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "keywords": [
    "openpen",
    "plugin",
    "module",
    "sdk"
  ],
  "dependencies": {
    "dompurify": "^3.4.10",
    "reka-ui": "~2.9.10"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  }
}
