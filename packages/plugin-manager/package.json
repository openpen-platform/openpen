{
  "name": "@openpen/plugin-manager",
  "version": "1.1.0",
  "description": "Shared install/remove/list logic for OpenPen plugins — used by the CLI and the in-app marketplace.",
  "author": "navishachiku <navishachiku@gmail.com>",
  "homepage": "https://github.com/openpen-platform/openpen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpen-platform/openpen.git",
    "directory": "packages/plugin-manager"
  },
  "bugs": {
    "url": "https://github.com/openpen-platform/openpen/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "openpen",
    "plugin",
    "manager",
    "install"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "~7.0.1",
    "unzipper": "~0.12.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
