{
  "name": "openpen",
  "version": "1.5.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "npm run build -w @openpen/plugin-manager && npm run build -w @openpen/module-api",
    "dev": "node scripts/dev.mjs",
    "type-check": "vue-tsc --noEmit && vue-tsc -p packages/module-api/tsconfig.json --noEmit",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run type-check && npm run build -w @openpen/module-api && vite build && npm run build:runtime",
    "test:prod-smoke": "npx playwright test --project=prod-smoke",
    "test:e2e": "npm run test:e2e:standard && npm run test:e2e:wayland",
    "test:e2e:standard": "XDG_SESSION_TYPE=x11 ELECTRON_OZONE_PLATFORM_HINT=x11 npx playwright test --project=functional",
    "test:e2e:wayland": "XDG_SESSION_TYPE=wayland ELECTRON_OZONE_PLATFORM_HINT=wayland npx playwright test --project=functional",
    "dist": "npm run build && npm run test:prod-smoke && electron-builder",
    "dist:mac": "npm run build && npm run test:prod-smoke && electron-builder --mac",
    "dist:win": "npm run build && npm run test:prod-smoke && electron-builder --win",
    "dist:linux": "npm run build && npm run test:prod-smoke && electron-builder --linux",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "catalog:serve": "node scripts/serve-catalog.mjs"
  },
  "build": {
    "appId": "com.openpen.app",
    "productName": "OpenPen",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "openpen-platform",
      "repo": "openpen"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "shared/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "OpenPen"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@openpen/plugin-manager": "*",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "koffi": "^3.1.1",
    "vue": "^3.5.40",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "^11.4.7",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@xmldom/xmldom": "~0.8.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.61.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vitest/coverage-v8": "~3.2.4",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "electron": "~42.5.1",
    "electron-builder": "~26.15.3",
    "eslint": "~10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "~1.61.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "~6.0.11",
    "vitest": "~3.2.4",
    "vue-tsc": "~3.3.7"
  }
}
