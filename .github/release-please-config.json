{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "openpen",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/build-cli": {
      "package-name": "@openpen/build",
      "changelog-path": "packages/build-cli/CHANGELOG.md"
    },
    "packages/module-api": {
      "package-name": "@openpen/module-api",
      "changelog-path": "packages/module-api/CHANGELOG.md"
    },
    "packages/openpen-cli": {
      "package-name": "openpen-cli",
      "changelog-path": "packages/openpen-cli/CHANGELOG.md"
    },
    "packages/plugin-manager": {
      "package-name": "@openpen/plugin-manager",
      "changelog-path": "packages/plugin-manager/CHANGELOG.md"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "openpen",
      "components": ["openpen", "@openpen/build", "@openpen/module-api", "openpen-cli", "@openpen/plugin-manager"]
    }
  ]
}
